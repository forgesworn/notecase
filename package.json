{
  "name": "@forgesworn/notecase",
  "version": "0.1.0",
  "private": true,
  "description": "An LNURLcash (LUD-25) wallet - a case for Lightning bearer notes. CLI-first, PIN-locked store, crash-safe mutation staging, NWC-assisted minting and melting.",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "notecase": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THREAT-MODEL.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgesworn/nwc-kit": "^0.1.7",
    "@forgesworn/shamir-words": "^1.1.0",
    "@noble/hashes": "^2.3.0",
    "farrier-kit": "^1.1.3",
    "keystore-kit": "file:../keystore-kit",
    "lnurlcash-kit": "file:../../Mint/lnurlcash-kit"
  },
  "devDependencies": {
    "@forgesworn/moneyer": "file:../moneyer",
    "@types/node": "^24.0.0",
    "lnurlcash-conformance": "file:../../Mint/lnurlcash-conformance",
    "nostr-tools": "2.24.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
