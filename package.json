{
  "name": "@forgesworn/notecase",
  "version": "0.10.0",
  "description": "An LNURLcash (LUD-25) wallet - a case for Lightning bearer notes. CLI-first, PIN-locked store, crash-safe mutation staging, NWC-assisted minting and melting.",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/notecase.git"
  },
  "homepage": "https://github.com/forgesworn/notecase#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/notecase/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "notecase": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THREAT-MODEL.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:preview": "vite preview web",
    "typecheck:web": "tsc -p web",
    "check": "npm run typecheck && npm run typecheck:web && npm test && npm run build && npm run web:build && npm pack --dry-run"
  },
  "dependencies": {
    "@forgesworn/nwc-kit": "^0.1.7",
    "@forgesworn/shamir-words": "^1.1.0",
    "@noble/hashes": "^2.3.0",
    "@scure/bip39": "^2.3.0",
    "farrier-kit": "^1.1.3",
    "keystore-kit": "^0.2.1",
    "lnurlcash-kit": "^0.4.0",
    "nostr-tools": "2.24.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@forgesworn/moneyer": "^0.3.1",
    "@types/node": "^24.0.0",
    "animejs": "^4.5.0",
    "happy-dom": "^20.11.2",
    "jsqr": "^1.4.0",
    "lnurlcash-conformance": "^0.2.2",
    "typescript": "^5.7.0",
    "uqr": "^0.1.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
